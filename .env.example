# Database (Vercel Postgres / Supabase / Neon)
# Pooled connection string for serverless API routes
POSTGRES_PRISMA_URL="postgres://default:password@ep-sample-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?pgbouncer=true&connect_timeout=15"
# Non-pooling direct connection string for Prisma migrations
POSTGRES_URL_NON_POOLING="postgres://default:password@ep-sample.us-east-1.postgres.vercel-storage.com:5432/verceldb"

# NextAuth / Security
NEXTAUTH_SECRET="replace-with-a-32-byte-hex-or-base64-random-string"
NEXTAUTH_URL="http://localhost:3000"

# W3C Web Push Notification Engine (Generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BEl62iUYgXXXXXXXXXXXXXX_replace_with_public_key"
VAPID_PUBLIC_KEY="BEl62iUYgXXXXXXXXXXXXXX_replace_with_public_key"
VAPID_PRIVATE_KEY="sK8z0XXXXXXXXXXXXXXXX_replace_with_private_key"
VAPID_SUBJECT="mailto:admin@nirmaanwatertech.com"

# Recurring task reminders: protects /api/reminders/run. Point a scheduler (Vercel Cron on Pro,
# or a free service like cron-job.org) at https://<your-domain>/api/reminders/run?secret=<CRON_SECRET>
# every 5–15 minutes.
CRON_SECRET="replace-with-a-random-string"
